       <!-- SECTION: Quota Productivity Matrix with Double Pill Capsule -->
       <item>
        <widget class="QGroupBox" name="groupQuotaMatrix">
         <property name="styleSheet">
          <string notr="true">
           QGroupBox#groupQuotaMatrix {
             background-color: #FFFFFF;
             border: 1px solid #DCE1E7;
             border-radius: 8px;
             margin-top: 8px;
             padding: 14px 12px 14px 12px;
             font-weight: bold;
           }
           QGroupBox#groupQuotaMatrix::title {
             subcontrol-origin: margin;
             subcontrol-position: top left;
             padding: 0 6px;
             color: #2D3748;
           }
          </string>
         </property>
         <property name="title">
          <string>Quota Productivity Matrix</string>
         </property>
         <layout class="QVBoxLayout" name="layoutQuotaMatrixInner">
          <property name="spacing"><number>12</number></property>

          <!-- Dynamic Header & Capsule Pills -->
          <item>
           <layout class="QHBoxLayout" name="layoutMatrixHeader">
            <item>
             <widget class="QLabel" name="lblQuotaMatrixTitle">
              <property name="font">
               <font><family>Segoe UI</family><pointsize>11</pointsize><bold>true</bold></font>
              </property>
              <property name="text">
               <string>Available Accounts Quota Productivity Matrix</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="lblPoolCountBadge">
              <property name="styleSheet">
               <string notr="true">color: #718096; font-size: 11px; font-family: monospace;</string>
              </property>
              <property name="text">
               <string>(Pool: 0)</string>
              </property>
             </widget>
            </item>
            <item>
             <spacer name="spacerMatrixHeader">
              <property name="orientation"><enum>Qt::Orientation::Horizontal</enum></property>
              <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
             </spacer>
            </item>
            <!-- Pill Capsule Controller -->
            <item>
             <widget class="QPushButton" name="btnOnlyAvailable">
              <property name="text"><string>Available (0)</string></property>
              <property name="checkable"><bool>true</bool></property>
              <property name="checked"><bool>true</bool></property>
              <property name="styleSheet">
               <string notr="true">
                QPushButton { background-color: #28A745; color: #FFFFFF; font-weight: bold; border: none; border-radius: 4px 0 0 4px; padding: 5px 12px; font-size: 11px; }
                QPushButton:!checked { background-color: #E2E8F0; color: #4A5568; }
               </string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnIncludeDisabled">
              <property name="text"><string>Include Disabled (0)</string></property>
              <property name="checkable"><bool>true</bool></property>
              <property name="styleSheet">
               <string notr="true">
                QPushButton { background-color: #E2E8F0; color: #4A5568; font-weight: bold; border: none; border-radius: 0 4px 4px 0; padding: 5px 12px; font-size: 11px; }
                QPushButton:checked { background-color: #0D6EFD; color: #FFFFFF; }
               </string>
              </property>
             </widget>
            </item>
           </layout>
          </item>

